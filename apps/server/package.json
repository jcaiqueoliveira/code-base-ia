{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@example-api/api": "*",
    "@example-api/db": "*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@example-api/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
